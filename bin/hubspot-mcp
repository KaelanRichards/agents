#!/usr/bin/env bash
# hubspot-mcp — mcp-remote bridge for HubSpot's official remote MCP server.
#
# HubSpot does not support dynamic client registration for MCP
# (registration_endpoint is null). Create an MCP Auth App in HubSpot
# (Development > MCP Auth Apps) and keep its credentials host-local,
# either as env vars or as a JSON file:
#
#   HUBSPOT_MCP_CLIENT_ID=...
#   HUBSPOT_MCP_CLIENT_SECRET=...
#   # optional:
#   HUBSPOT_MCP_SCOPES="..."
#
# Or:
#   HUBSPOT_MCP_CLIENT_INFO_FILE=~/.config/agents-secrets/hubspot-mcp-client-info.json
#
# The MCP Auth App must allow http://127.0.0.1:3340/oauth/callback as an
# OAuth redirect URL, or set HUBSPOT_MCP_CALLBACK_PORT to match the app.
set -euo pipefail

# Self-source host-local HubSpot app creds when not already in env. The env path is
# normal (interactive shells export these). The file fallback exists because the Codex
# runtime does NOT pass the parent env to MCP children, so a Codex-spawned bridge would
# otherwise have no client creds and fall through to empty-mcp. No secret enters tracked
# config.
if [ -z "${HUBSPOT_MCP_CLIENT_INFO_FILE:-}" ]; then
	for f in "$HOME/.config/agents-secrets/hubspot-mcp.env" "$HOME/.config/agents-secrets/hubspot.env"; do
		# shellcheck source=/dev/null
		[ -r "$f" ] && {
			set -a
			. "$f"
			set +a
		}
	done
fi

url="${HUBSPOT_MCP_URL:-https://mcp.hubspot.com}"
port="${HUBSPOT_MCP_CALLBACK_PORT:-3340}"
host="${HUBSPOT_MCP_CALLBACK_HOST:-127.0.0.1}"
mcp_remote_pkg="${HUBSPOT_MCP_REMOTE_PACKAGE:-mcp-remote@0.1.38}"

cleanup() {
	[ -n "${info_file_tmp:-}" ] && rm -f "$info_file_tmp"
	[ -n "${metadata_file_tmp:-}" ] && rm -f "$metadata_file_tmp"
}
trap cleanup EXIT INT TERM

if [ -n "${HUBSPOT_MCP_CLIENT_INFO_FILE:-}" ]; then
	info_file="$HUBSPOT_MCP_CLIENT_INFO_FILE"
else
	if [ -z "${HUBSPOT_MCP_CLIENT_ID:-}" ] || [ -z "${HUBSPOT_MCP_CLIENT_SECRET:-}" ]; then
		exec "$HOME/.config/agents/bin/empty-mcp" hubspot "set HUBSPOT_MCP_CLIENT_ID and HUBSPOT_MCP_CLIENT_SECRET, or HUBSPOT_MCP_CLIENT_INFO_FILE"
	fi
	info_file_tmp=$(mktemp)
	jq -n \
		--arg client_id "$HUBSPOT_MCP_CLIENT_ID" \
		--arg client_secret "$HUBSPOT_MCP_CLIENT_SECRET" \
		'{client_id:$client_id, client_secret:$client_secret}' >"$info_file_tmp"
	chmod 600 "$info_file_tmp"
	info_file="$info_file_tmp"
fi

metadata_file_tmp=$(mktemp)
jq -n --arg scope "${HUBSPOT_MCP_SCOPES:-}" '{
  token_endpoint_auth_method: "client_secret_post",
  grant_types: ["authorization_code", "refresh_token"],
  response_types: ["code"]
} + (if $scope != "" then {scope: $scope} else {} end)' >"$metadata_file_tmp"
chmod 600 "$metadata_file_tmp"

npx -y "$mcp_remote_pkg" "$url" "$port" \
	--host "$host" \
	--static-oauth-client-info "@$info_file" \
	--static-oauth-client-metadata "@$metadata_file_tmp" \
	"$@"
