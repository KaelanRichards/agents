#!/usr/bin/env bash
# agents-doctor — health check for the shared agent environment (laptop + VM).
# Verifies tools, symlinks, MCP parity, config validity, hooks, and agent-CLI version drift.
# Exit non-zero on any error (CI-friendly). Run anytime:  agents-doctor
set -uo pipefail
AH="${AGENTS_HOME:-$HOME/.config/agents}"
ERR=0
WARN=0
bad() {
	printf '  [FAIL] %s\n' "$1"
	ERR=$((ERR + 1))
}
warn() {
	printf '  [warn] %s\n' "$1"
	WARN=$((WARN + 1))
}
ok() { printf '  [ ok ] %s\n' "$1"; }

echo "== tools =="
missing=""
for t in jj git mise uv rg fd fzf jq yq ast-grep sd gron bat eza tree scc ruff biome shellcheck shfmt just watchexec entr hyperfine xh pandoc starship gh delta; do
	command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
done
[ -z "$missing" ] && ok "core toolbelt present" || bad "missing tools:$missing"
for t in claude codex; do
	command -v "$t" >/dev/null 2>&1 && ok "$t present" || warn "$t not on PATH"
done

echo "== instruction symlinks =="
# Resolve the FULL chain, not one hop: home-manager points these at the Nix store, which
# then out-of-store-symlinks back to canonical. Single-hop readlink made this check fail
# permanently on this host — a check that always fails cannot warn about a real break.
canon_agents=$(realpath "$AH/AGENTS.md" 2>/dev/null || echo "$AH/AGENTS.md")
for f in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
	if [ "$(realpath "$f" 2>/dev/null)" = "$canon_agents" ]; then
		ok "${f/#"$HOME"/~} -> AGENTS.md"
	else
		bad "${f/#"$HOME"/~} not linked to canonical AGENTS.md"
	fi
done

echo "== helper scripts on PATH =="
for s in "$AH"/bin/*; do
	# Only real executables are helpers. The bare glob also matched build cruft such as
	# bin/__pycache__, producing a permanent bogus warn.
	[ -f "$s" ] && [ -x "$s" ] || continue
	n=$(basename "$s")
	[ -x "$HOME/.local/bin/$n" ] && ok "$n" || warn "$n not on ~/.local/bin (run bootstrap or re-link)"
done

echo "== MCP parity =="
if command -v jq >/dev/null 2>&1; then
	# Render into an isolated HOME, then compare the exact generated server objects. This catches
	# equal-count drift in names, transports, URLs, policy, and enabled state without printing values.
	sync_tmp=$(mktemp -d)
	mkdir -p "$sync_tmp/home"
	if HOME="$sync_tmp/home" AGENTS_HOME="$AH" "$AH/bin/mcp-sync" >/dev/null 2>&1; then
		if cmp -s <(jq -S '.mcpServers // {}' "$sync_tmp/home/.claude.json") <(jq -S '.mcpServers // {}' "$HOME/.claude.json"); then
			ok "Claude MCP config exactly matches generated source"
		else
			bad "Claude MCP config drift (run: mcp-sync)"
		fi
		if cmp -s <(yq -p toml -o json "$sync_tmp/home/.codex/config.toml" | jq -S '.mcp_servers // {}') <(yq -p toml -o json "$HOME/.codex/config.toml" | jq -S '.mcp_servers // {}'); then
			ok "Codex MCP config exactly matches generated source"
		else
			bad "Codex MCP config drift (run: mcp-sync)"
		fi
	else
		bad "could not render MCP configs for parity check"
	fi
	rm -r "$sync_tmp"
	required_mcp="context7 github datadog sentry bigquery agents personal-actions linear notion granola cloudflare slack hubspot"
	for s in $required_mcp; do
		jq -e --arg s "$s" '.mcpServers[$s]' "$AH/mcp.json" >/dev/null 2>&1 && ok "MCP required server present: $s" || bad "missing required MCP server: $s"
	done
	jq -e '.mcpServers.datadog.url == "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=core,apm,error-tracking,software-delivery"' "$AH/mcp.json" >/dev/null 2>&1 && ok "Datadog MCP US5 URL pinned" || bad "Datadog MCP URL mismatch"
	jq -e '(.mcpServers.datadog.headers // {}) == {} and (.mcpServers.datadog.bearer_token_env_var // "") == ""' "$AH/mcp.json" >/dev/null 2>&1 && ok "Datadog MCP uses client-native remote auth" || bad "Datadog MCP shared config should not force static header auth"
	jq -e '.mcpServers.datadog.clients.codex == {"type":"http","url":"https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp"}' "$AH/mcp.json" >/dev/null 2>&1 && ok "Datadog MCP Codex resource URL pinned" || bad "Datadog MCP Codex override mismatch"
	jq -e '.mcpServers.github.url == "https://api.githubcopilot.com/mcp/" and .mcpServers.github.bearer_token_env_var == "GITHUB_PAT"' "$AH/mcp.json" >/dev/null 2>&1 && ok "GitHub MCP endpoint + bearer (GITHUB_PAT) pinned" || bad "GitHub MCP endpoint/bearer mismatch"
	jq -e '.mcpServers.linear.type == "stdio" and .mcpServers.linear.command == "npx" and .mcpServers.linear.args == ["-y","mcp-remote@0.1.38","https://mcp.linear.app/mcp","3336","--host","127.0.0.1"]' "$AH/mcp.json" >/dev/null 2>&1 && ok "Linear MCP mcp-remote bridge pinned" || bad "Linear MCP bridge mismatch"
	jq -e '.mcpServers.sentry.type == "stdio" and .mcpServers.sentry.command == "npx" and .mcpServers.sentry.args == ["-y","mcp-remote@0.1.38","https://mcp.sentry.dev/mcp","3337","--host","127.0.0.1"]' "$AH/mcp.json" >/dev/null 2>&1 && ok "Sentry MCP mcp-remote bridge pinned" || bad "Sentry MCP bridge mismatch"
	jq -e '.mcpServers.notion.type == "stdio" and .mcpServers.notion.command == "npx" and .mcpServers.notion.args == ["-y","mcp-remote@0.1.38","https://mcp.notion.com/mcp","3334","--host","127.0.0.1"]' "$AH/mcp.json" >/dev/null 2>&1 && ok "Notion MCP mcp-remote bridge pinned" || bad "Notion MCP bridge mismatch"
	jq -e '.mcpServers.granola.type == "stdio" and .mcpServers.granola.command == "npx" and .mcpServers.granola.args == ["-y","mcp-remote@0.1.38","https://mcp.granola.ai/mcp","3335","--host","127.0.0.1"]' "$AH/mcp.json" >/dev/null 2>&1 && ok "Granola MCP mcp-remote bridge pinned" || bad "Granola MCP bridge mismatch"
	jq -e '.mcpServers.cloudflare.type == "stdio" and .mcpServers.cloudflare.command == "npx" and .mcpServers.cloudflare.args == ["-y","mcp-remote@0.1.38","https://mcp.cloudflare.com/mcp","3338","--host","127.0.0.1"]' "$AH/mcp.json" >/dev/null 2>&1 && ok "Cloudflare MCP mcp-remote bridge pinned" || bad "Cloudflare MCP bridge mismatch"
	jq -e '.mcpServers.cloudflare.clients.codex == {"type":"http","url":"https://mcp.cloudflare.com/mcp"}' "$AH/mcp.json" >/dev/null 2>&1 && ok "Cloudflare MCP Codex native HTTP override pinned" || bad "Cloudflare MCP Codex override mismatch"
	jq -e '.mcpServers.slack.type == "stdio" and .mcpServers.slack.command == "$AGENTS_HOME/bin/slack-official-mcp" and .mcpServers.slack.args == []' "$AH/mcp.json" >/dev/null 2>&1 && ok "Slack MCP wrapper pinned" || bad "Slack MCP wrapper mismatch"
	# Accept either an $AGENTS_HOME placeholder (portable canonical) or an absolute path to $AH/bin/bigquery-mcp.
	bq_cmd=$(jq -r '.mcpServers.bigquery.command // ""' "$AH/mcp.json" 2>/dev/null)
	if [ "$bq_cmd" = "\$AGENTS_HOME/bin/bigquery-mcp" ] || [ "$bq_cmd" = "$AH/bin/bigquery-mcp" ]; then
		ok "BigQuery MCP local facade pinned"
	else
		bad "BigQuery MCP command mismatch (got: $bq_cmd)"
	fi
fi

echo "== config validity =="
jq -e . "$AH/mcp.json" >/dev/null 2>&1 && ok "mcp.json" || bad "mcp.json invalid JSON"
jq -e . "$AH/mcp.auth.json" >/dev/null 2>&1 && ok "mcp.auth.json" || bad "mcp.auth.json invalid JSON"
if [ -x "$AH/bin/mcp-auth" ]; then
	AGENTS_HOME="$AH" "$AH/bin/mcp-auth" check >/dev/null 2>&1 && ok "MCP auth contract" || bad "MCP auth contract mismatch"
	health_json=$(AGENTS_HOME="$AH" "$AH/bin/mcp-auth" health --client codex --offline --json 2>/dev/null)
	health_rc=$?
	if [ "$health_rc" -eq 0 ] && jq -e '.summary.broken == 0' <<<"$health_json" >/dev/null 2>&1; then
		health_summary=$(jq -r '.summary | "ready=\(.ready) auth-required=\(."auth-required") disabled=\(.disabled) unverified=\(.unverified)"' <<<"$health_json")
		ok "MCP static health, Codex ($health_summary)"
	else
		bad "MCP static health found broken Codex entries (run: mcp-auth health --client codex --offline)"
	fi
else
	bad "mcp-auth helper missing"
fi
[ -f "$HOME/.claude/settings.json" ] && { jq -e . "$HOME/.claude/settings.json" >/dev/null 2>&1 && ok "claude settings.json" || bad "claude settings.json invalid"; }
if [ -f "$HOME/.codex/config.toml" ]; then
	if command -v yq >/dev/null 2>&1; then
		yq -p toml "$HOME/.codex/config.toml" >/dev/null 2>&1 && ok "codex config.toml" || bad "codex config.toml invalid TOML"
	elif command -v python3 >/dev/null 2>&1; then
		python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' "$HOME/.codex/config.toml" >/dev/null 2>&1 && ok "codex config.toml (tomllib)" || bad "codex config.toml invalid TOML"
	else
		warn "no TOML validator (yq/python3) — cannot verify codex config.toml"
	fi
	# experimental_use_rmcp_client is required by the direct-HTTP servers (github/datadog), NOT the
	# stdio mcp-remote bridges — gate the check on the http servers that actually need it.
	if grep -qE '^\[mcp_servers\."(github|datadog)"\]' "$HOME/.codex/config.toml"; then
		grep -qF 'experimental_use_rmcp_client = true' "$HOME/.codex/config.toml" && ok "codex remote MCP feature enabled (http servers)" || bad "codex http MCP servers (github/datadog) require experimental_use_rmcp_client = true"
	fi
fi
command -v jj >/dev/null 2>&1 && { jj config list --user >/dev/null 2>&1 && ok "jj config" || bad "jj config invalid"; }

echo "== hooks =="
if [ -f "$HOME/.claude/settings.json" ]; then
	jq -e '.hooks.PreToolUse and .hooks.PostToolUse' "$HOME/.claude/settings.json" >/dev/null 2>&1 && ok "claude hooks wired" || warn "claude hooks not wired (run agents-sync)"
fi
if [ -f "$HOME/.codex/config.toml" ]; then
	if grep -qF '[[hooks.PreToolUse]]' "$HOME/.codex/config.toml" && grep -qF '[[hooks.PostToolUse]]' "$HOME/.codex/config.toml"; then
		ok "codex hooks wired"
	else
		warn "codex hooks not wired (run agents-sync)"
	fi
fi

echo "== agent control plane =="
if command -v agent-profile >/dev/null 2>&1; then
	agent-profile validate >/dev/null 2>&1 && ok "agent profiles valid" || bad "agent profiles invalid"
else
	warn "agent-profile not on PATH"
fi
if [ -x "$AH/bin/agentp" ]; then
	ok "agentp profile launcher present"
else
	bad "agentp profile launcher missing"
fi
if [ -x "$AH/hooks/profile-broker.sh" ]; then
	if [ -f "$HOME/.claude/settings.json" ] && grep -qF 'profile-broker.sh' "$HOME/.claude/settings.json"; then
		ok "profile-broker PreToolUse hook wired (native enforcement)"
	else
		warn "profile-broker hook present but not wired into Claude settings (run agents-sync)"
	fi
else
	bad "profile-broker hook missing or not executable"
fi

echo "== skill sync =="
canonical_skills=$(find "$AH/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
claude_skills=$(find "$HOME/.claude/skills" -mindepth 1 -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
codex_skills=$(find "$HOME/.codex/skills" -mindepth 1 -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
# skills.disabled is deliberately unlinked in BOTH tools, so the target is canonical minus
# disabled. What actually matters is Claude/Codex PARITY — a per-tool disable list is what
# let Codex keep running skills Claude had switched off.
disabled_skills=0
# grep -c prints the count even when it exits 1 (zero matches), so don't `|| echo 0` —
# that emits a second line and breaks the arithmetic below.
[ -f "$AH/skills.disabled" ] &&
	disabled_skills=$(grep -cvE '^[[:space:]]*(#|$)' "$AH/skills.disabled" 2>/dev/null) || true
disabled_skills=${disabled_skills:-0}
expected_skills=$((canonical_skills - disabled_skills))
if [ "$expected_skills" = "$claude_skills" ] && [ "$expected_skills" = "$codex_skills" ]; then
	ok "canonical skills linked to Claude + Codex ($expected_skills enabled, $disabled_skills disabled)"
elif [ "$claude_skills" != "$codex_skills" ]; then
	bad "skill PARITY broken: claude=$claude_skills codex=$codex_skills (run agents-sync)"
else
	bad "skill count mismatch: expected=$expected_skills (canonical=$canonical_skills - disabled=$disabled_skills) claude=$claude_skills codex=$codex_skills (run agents-sync)"
fi
broken_skills=$(find "$HOME/.claude/skills" "$HOME/.codex/skills" -mindepth 1 -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null | wc -l | tr -d ' ')
[ "$broken_skills" = "0" ] && ok "no broken skill links" || bad "broken skill symlinks: $broken_skills"
if [ -f "$AH/skills.lock.json" ]; then
	lock_skills=$(jq '.skills | length' "$AH/skills.lock.json" 2>/dev/null || echo -1)
	[ "$lock_skills" = "$canonical_skills" ] && ok "skills.lock.json covers all canonical skills" || bad "skills.lock.json count mismatch: lock=$lock_skills canonical=$canonical_skills"
else
	bad "missing skills.lock.json"
fi

echo "== personal actions =="
if [ "${PERSONAL_ACTIONS_DRY_RUN:-1}" = "0" ] || [ -n "${PERSONAL_ACTIONS_WEBHOOK_URL:-}" ]; then
	ok "personal actions live provider env present"
else
	ok "personal actions default to dry-run"
fi

echo "== personal action auth =="
pa_env="$HOME/.config/agents-secrets/personal-actions.env"
if [ -f "$pa_env" ]; then
	for key in PERSONAL_GMAIL_COMPOSE_REFRESH_TOKEN PERSONAL_GMAIL_MODIFY_REFRESH_TOKEN PERSONAL_WORK_GMAIL_MODIFY_REFRESH_TOKEN; do
		if awk -F= -v k="$key" '$1==k && length($2)>0 {found=1} END {exit found?0:1}' "$pa_env"; then
			ok "$key configured"
		else
			warn "$key missing"
		fi
	done
	if awk -F= '$1=="PERSONAL_WORK_GMAIL_COMPOSE_REFRESH_TOKEN" && length($2)>0 {found=1} END {exit found?0:1}' "$pa_env"; then
		ok "PERSONAL_WORK_GMAIL_COMPOSE_REFRESH_TOKEN configured"
	else
		warn "PERSONAL_WORK_GMAIL_COMPOSE_REFRESH_TOKEN missing (run personal-actions-google-compose-auth --account work if work drafts are needed)"
	fi
else
	warn "missing $pa_env"
fi

echo "== BigQuery auth =="
if command -v gcloud >/dev/null 2>&1 && command -v bq >/dev/null 2>&1; then
	bq_project=$(gcloud config get-value project 2>/dev/null || true)
	[ "$bq_project" = "vizcom-web" ] && ok "gcloud active project: vizcom-web" || warn "gcloud active project is ${bq_project:-unset}; expected vizcom-web"
	bq_account=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null || true)
	[ -n "$bq_account" ] && ok "gcloud active account: $bq_account" || warn "no active gcloud account"
	if bq --project_id=vizcom-web query --use_legacy_sql=false --format=prettyjson 'SELECT 1 AS ok' >/dev/null 2>&1; then
		ok "BigQuery read query works"
	else
		warn "BigQuery read query failed; run gcloud auth login and verify vizcom-web IAM"
	fi
else
	warn "gcloud/bq not installed"
fi

echo "== repo sync =="
if command -v jj >/dev/null 2>&1 && jj -R "$AH" root >/dev/null 2>&1; then
	current_bookmarks=$(jj -R "$AH" log -r @ --no-graph -T 'bookmarks.join(" ")' 2>/dev/null || true)
	[ -n "$current_bookmarks" ] && ok "current config change has bookmark(s): $current_bookmarks" || warn "current config change has no bookmark"
fi

echo "== agent-CLI version drift =="
vfile="$AH/.doctor-versions"
cur=$(mktemp)
{
	command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -1
	command -v codex >/dev/null 2>&1 && codex --version 2>/dev/null | head -1
} >"$cur"
if [ -f "$vfile" ]; then
	diff -q "$vfile" "$cur" >/dev/null 2>&1 && ok "agent CLI versions unchanged" || { warn "agent CLI version changed — re-verify mcp-sync/agents-sync output"; cp "$cur" "$vfile"; }
else
	cp "$cur" "$vfile"
	ok "recorded agent CLI version baseline"
fi
rm -f "$cur"

echo "== container runtime (local dev) =="
if command -v docker >/dev/null 2>&1; then
	if docker info >/dev/null 2>&1; then ok "docker present + daemon running"
	else warn "docker on PATH but daemon not running (OrbStack: 'orb start')"; fi
elif command -v orb >/dev/null 2>&1; then
	warn "OrbStack installed but 'docker' not on PATH (run 'orb start')"
else
	warn "no container runtime (docker/OrbStack) — needed to run local service deps"
fi

echo "== agent shell PATH (non-interactive zsh) =="
# the agent Bash tool runs commands in a non-interactive shell; it must resolve the toolchain
# without a manual `eval "$(brew shellenv)"`. This catches a missing/broken ~/.zshenv wiring.
if command -v zsh >/dev/null 2>&1; then
	miss=""
	for t in node rg jq; do zsh -c "command -v $t" >/dev/null 2>&1 || miss="$miss $t"; done
	[ -z "$miss" ] && ok "non-interactive zsh resolves toolchain (node/rg/jq)" ||
		bad "non-interactive zsh missing:$miss — wire ~/.zshenv -> agents.env.zsh (run bootstrap)"
else
	warn "zsh not installed — agent shell PATH check skipped"
fi

echo
[ "$ERR" -gt 0 ] && {
	echo "FAILED: $ERR error(s), $WARN warning(s)"
	exit 1
}
echo "HEALTHY: 0 errors, $WARN warning(s)"
